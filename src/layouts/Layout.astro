---
import { url } from '../lib/url';
// Fonts are self-hosted (no Google Fonts round trip); only the weights in use.
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand, openWeeks, leadDays } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  minimal?: boolean; // checkout uses a stripped-down header, no footer
  overlay?: boolean; // header sits transparent over a full-bleed hero until scrolled
  noindex?: boolean; // internal pages
}

const {
  title = `${brand.name} by ${brand.parent} — Websites without the agency`,
  description = 'Custom websites, designed, written and built for a fixed price in 5–20 business days. No proposals, no hourly billing, no meetings required.',
  minimal = false,
  overlay = false,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={brand.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content={brand.theme === 'green' ? '#0a211f' : brand.theme === 'black' ? '#0d0d0d' : brand.theme === 'pitch' ? '#0b0b0b' : '#050505'} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // ?theme=pitch|void|black|green previews a style; it sticks for the browser session.
      try {
        const t = new URLSearchParams(location.search).get('theme') || sessionStorage.getItem('theme');
        if (t === 'green' || t === 'black' || t === 'void' || t === 'pitch') {
          document.documentElement.dataset.theme = t;
          sessionStorage.setItem('theme', t);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] btn-primary">Skip to content</a>
    <Header minimal={minimal} overlay={overlay} />
    <main id="main">
      <slot />
    </main>
    {!minimal && <Footer />}

    <!-- Safety net if a nightly rebuild fails: hide build weeks that have started (or are inside the
         brief lead time) and point every "next build" label at the first week still open. -->
    <script is:inline define:vars={{ open: openWeeks.map(({ start, label }) => ({ start, label })), leadDays }}>
      const cutoff = new Date(Date.now() + leadDays * 864e5).toISOString().slice(0, 10);
      document.querySelectorAll('[data-week]').forEach((el) => {
        if (el.dataset.week >= cutoff) return;
        el.hidden = true;
        el.querySelectorAll('input').forEach((i) => { i.disabled = true; i.checked = false; });
      });
      const next = open.find((w) => w.start >= cutoff);
      if (next) {
        document.querySelectorAll('[data-next-week]').forEach((el) => { el.textContent = next.label; });
        document.querySelectorAll('[data-next-week-href]').forEach((el) => { el.setAttribute('href', el.getAttribute('href').replace(/week=[\d-]+/, 'week=' + next.start)); });
      }
    </script>

    <script>
      // Header turns into the floating pill after a little scroll.
      const header = document.querySelector<HTMLElement>('.site-header');
      const mobile = matchMedia('(max-width: 767px)');
      const onScroll = () => header?.toggleAttribute('data-scrolled', mobile.matches || scrollY > 24);
      mobile.addEventListener('change', onScroll);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
    <script>
      // Scroll reveal. Elements are visible without JS; see global.css.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
    <script>
      // Every <details> opens and closes with a height animation instead of snapping.
      const ease = 'cubic-bezier(.2,.7,.2,1)';
      document.querySelectorAll('details').forEach((d) => {
        const s = d.querySelector(':scope > summary');
        if (!s) return;
        let anim = null;
        s.addEventListener('click', (e) => {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          e.preventDefault();
          const start = d.offsetHeight;
          anim?.cancel();
          const opening = !d.open || 'closing' in d.dataset;
          let end;
          if (opening) {
            delete d.dataset.closing;
            d.open = true;
            end = d.offsetHeight;
          } else {
            d.dataset.closing = '';
            end = s.offsetHeight + (d.offsetHeight - d.clientHeight);
          }
          d.style.overflow = 'hidden';
          anim = d.animate({ height: [`${start}px`, `${end}px`] }, { duration: 420, easing: ease });
          anim.onfinish = () => {
            if (!opening) { d.open = false; delete d.dataset.closing; }
            d.style.overflow = '';
            anim = null;
          };
        });
      });
    </script>
  </body>
</html>
