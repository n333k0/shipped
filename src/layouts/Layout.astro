---
import { url } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  minimal?: boolean; // checkout uses a stripped-down header, no footer
  overlay?: boolean; // header sits transparent over a full-bleed hero until scrolled
}

const {
  title = `${brand.name} by ${brand.parent} — Websites without the agency`,
  description = 'Custom websites, designed, written and built for a fixed price in 5–20 business days. No proposals, no hourly billing, no meetings required.',
  minimal = false,
  overlay = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={brand.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content={brand.theme === 'green' ? '#0a211f' : brand.theme === 'black' ? '#0d0d0d' : brand.theme === 'pitch' ? '#000000' : '#050505'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
      // ?theme=pitch|void|black|green previews a style; it sticks for the browser session.
      try {
        const t = new URLSearchParams(location.search).get('theme') || sessionStorage.getItem('theme');
        if (t === 'green' || t === 'black' || t === 'void' || t === 'pitch') {
          document.documentElement.dataset.theme = t;
          sessionStorage.setItem('theme', t);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] btn-primary">Skip to content</a>
    <Header minimal={minimal} overlay={overlay} />
    <main id="main">
      <slot />
    </main>
    {!minimal && <Footer />}

    <script>
      // Header turns into the floating pill after a little scroll.
      const header = document.querySelector<HTMLElement>('.site-header');
      const mobile = matchMedia('(max-width: 767px)');
      const onScroll = () => header?.toggleAttribute('data-scrolled', mobile.matches || scrollY > 24);
      mobile.addEventListener('change', onScroll);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
    <script>
      // Scroll reveal. Elements are visible without JS; see global.css.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
