---
import { url } from '../lib/url';
import Logo from './Logo.astro';
import ParentLogo from './ParentLogo.astro';
import { brand, packages, showPlaceholderTags, family } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-pine-950 pt-20 pb-10">
  <div class="wrap">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-4 max-w-xs text-[15px] text-paper/60">Custom websites. Fixed price. Known launch date.</p>
        <p class="label mt-6 text-paper/40">Async by default · Built in Framer</p>
        <p class="mt-8 flex items-center gap-2 text-paper/70"><span class="label text-paper/40">A product by</span><ParentLogo class="h-[16px]" /></p>
      </div>
      <div>
        <p class="label text-paper/40">Packages</p>
        <ul class="mt-4 space-y-2 text-[15px] text-paper/80">
          {packages.map((p) => <li><a class="hover:text-spark" href={url(`/start/?package=${p.id}`)}>{p.name} · {p.priceLabel}</a></li>)}
          <li><a class="hover:text-spark" href={url('/budget/')}>Custom · name your budget</a></li>
        </ul>
      </div>
      <div>
        <p class="label text-paper/40">RemotoLabs products</p>
        <ul class="mt-4 space-y-2 text-[15px] text-paper/80">
          {family.map((f) => <li><a class="hover:text-spark" href={f.url}>{f.name}</a> <span class="text-paper/45">{f.line}</span></li>)}
        </ul>
        <p class="label mt-8 text-paper/40">Studio</p>
        <ul class="mt-4 space-y-2 text-[15px] text-paper/80">
          <li><a class="hover:text-spark" href={url('/#work')}>Work</a></li>
          <li><a class="hover:text-spark" href={url('/#process')}>Process</a></li>
          <li><a class="hover:text-spark" href={url('/#calendar')}>Availability</a></li>
          <li><a class="hover:text-spark" href={url('/#faq')}>FAQ</a></li>
        </ul>
      </div>
      <div>
        <p class="label text-paper/40">Talk to a human</p>
        <ul class="mt-4 space-y-2 text-[15px] text-paper/80">
          <li><a class="hover:text-spark" href={`mailto:${brand.email}`}>{brand.email}</a></li>
          <li><a class="hover:text-spark" href={brand.callLink}>Book a 15-min call</a></li>
        </ul>
      </div>
    </div>

    <div id="footer-word-box" class="mt-24 overflow-hidden" aria-hidden="true">
      <p id="footer-word" class="display select-none whitespace-nowrap text-[clamp(64px,22vw,300px)] leading-[0.8] text-white/[0.06]"><span>{brand.name.toLowerCase()}.</span></p>
    </div>

    <div class="mt-3 sm:mt-5 flex flex-col justify-between gap-3 border-t border-white/10 pt-6 text-[13px] text-paper/40 sm:flex-row">
      <p>© {year} {brand.parent}. {brand.name} is a {brand.parent} product. You own your website; we just build it.</p>
      {showPlaceholderTags && <p class="label">Imagery: placeholders, to be replaced with our work</p>}
    </div>
  </div>
</footer>

<script>
  // Fit the watermark to the content width by its *ink* (the visible letter shapes, tails included),
  // so it sits flush with the content edges and its lowest point sits right above the line.
  // The box clips it, so on scroll the word slides up out of that mask.
  const word = document.getElementById('footer-word');
  const box = document.getElementById('footer-word-box');
  if (word && box) {
    const span = word.firstElementChild as HTMLElement;
    const fit = () => {
      const cs = getComputedStyle(word);
      const S = 200; // measure at 200px
      const c = document.createElement('canvas');
      const ctx = c.getContext('2d');
      if (!ctx) return;
      const text = span.textContent ?? '';
      const pad = S;
      c.width = Math.ceil(S * text.length + pad * 2);
      c.height = S * 2;
      ctx.font = `${cs.fontWeight} ${S}px ${cs.fontFamily}`;
      const ls = (parseFloat(cs.letterSpacing) / parseFloat(cs.fontSize)) * S || 0;
      if ('letterSpacing' in ctx) (ctx as any).letterSpacing = `${ls}px`;
      ctx.fillText(text, pad, S * 1.5);
      const { data } = ctx.getImageData(0, 0, c.width, c.height);
      let minX = c.width, maxX = 0, minY = c.height, maxY = 0;
      for (let y = 0; y < c.height; y++) for (let x = 0; x < c.width; x++) {
        if (data[(y * c.width + x) * 4 + 3] > 8) { if (x < minX) minX = x; if (x > maxX) maxX = x; if (y < minY) minY = y; if (y > maxY) maxY = y; }
      }
      if (maxX <= minX) return;
      const m = ctx.measureText(text);
      const A = m.fontBoundingBoxAscent, D = m.fontBoundingBoxDescent;
      const k = box.clientWidth / (maxX - minX + 1);
      const inkAscent = S * 1.5 - minY, inkDescent = maxY + 1 - S * 1.5;
      word.style.fontSize = `${S * k}px`;
      word.style.lineHeight = `${(A + D) * k}px`;
      word.style.marginLeft = `${-(minX - pad) * k}px`;
      word.style.marginTop = `${-(A - inkAscent) * k}px`;
      word.style.marginBottom = `${-(D - inkDescent) * k}px`;
    };
    document.fonts.ready.then(fit);
    addEventListener('resize', fit);
    // reveal: rises when the box scrolls into view, resets once it is back below the fold
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) box.classList.add('in');
      else if (e.boundingClientRect.top > 0) box.classList.remove('in');
    }, { threshold: 0.35 }).observe(box);
  }
</script>

<style>
  #footer-word { transform: translateY(105%); transition: transform 1.3s cubic-bezier(.16, 1, .3, 1); }
  #footer-word-box.in #footer-word { transform: none; }
  @media (prefers-reduced-motion: reduce) { #footer-word { transform: none; transition: none; } }
</style>
