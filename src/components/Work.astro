---
import { work } from '../data/site';
import { url } from '../lib/url';
---

<section id="work" class="py-24 sm:py-32">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="label text-spark">Selected work</p>
        <h2 class="display mt-4 text-[clamp(40px,6vw,80px)]">The process is repeatable.<br /><span class="accent text-spark">The website isn’t.</span></h2>
      </div>
      <p class="max-w-sm text-[16px] text-paper/60">Same five steps every time. A different website every time. Here’s what came out the other end.</p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {work.map((w, i) => (
        <article class:list={['group', i === 0 && 'lg:col-span-2 lg:row-span-2']} data-reveal>
          <div class:list={['relative overflow-hidden rounded-[22px] bg-pine-800', i === 0 ? 'aspect-[4/3] lg:aspect-auto lg:h-[calc(100%-112px)]' : 'aspect-[4/3]']}>
            <img src={url(w.img)} alt={`${w.title} website (placeholder image)`} loading="lazy" class="size-full object-cover transition duration-700 group-hover:scale-[1.03]" />
            <span class="placeholder-tag absolute left-4 top-4">Placeholder</span>
            <span class="chip absolute right-4 top-4 border-white/20 bg-pine-900/70 text-paper backdrop-blur">{w.pkg} · {w.days}</span>
          </div>
          <div class="mt-4">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-[20px] font-medium tracking-tight">{w.title} <span class="text-paper/45">· {w.industry}</span></h3>
              <p class="text-[15px] text-spark">{w.focus}</p>
            </div>
            <p class="label mt-2 text-paper/45">{w.scope.join(' · ')}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
