---
import { url } from '../lib/url';
import { brand } from '../data/site';
const { class: cls = '' } = Astro.props;
---

<a href={url('/')} class:list={['inline-flex items-center', cls]} aria-label={`${brand.name} home`}>
  <span class="inline-flex items-baseline text-[24px] font-semibold tracking-[-0.04em]">
    {brand.name.toLowerCase()}<span class="logo-dot"></span>
  </span>
</a>
