---
import { url } from '../lib/url';
import { addOns } from '../data/site';
const groups = [...new Set(addOns.map((a) => a.group))];
---

<section id="add-ons" class="bg-paper py-12 text-ink sm:py-16">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="label text-pine-500">Add-ons</p>
        <h2 class="display mt-4 t-h2">Configure it. <span class="accent">Don’t negotiate it.</span></h2>
      </div>
      <p class="max-w-sm text-[16px] text-ink/60">Need more? Tick a box, see the new price and timeline. Same as speccing a laptop, minus the anxiety.</p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {groups.map((g) => (
        <div class="rounded-[24px] border border-ink/10 bg-white p-6" data-reveal>
          <p class="label text-ink/45">{g}</p>
          <ul class="mt-4 divide-y divide-ink/10">
            {addOns.filter((a) => a.group === g).map((a) => (
              <li class="py-4">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="text-[16px] font-semibold">{a.name}</p>
                  <p class="shrink-0 font-mono text-[13px] text-pine-600">
                    {a.was && <s class="mr-1 text-ink/35">{a.was}</s>}
                    {a.priceLabel}
                    {a.promo && <span class="ml-1 rounded-full bg-spark px-1.5 py-0.5 text-[10px] uppercase tracking-[0.1em] text-ink">{a.promo}</span>}
                  </p>
                </div>
                <p class="mt-1 text-[14px] text-ink/55">{a.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-5 flex flex-col items-start justify-between gap-4 rounded-[24px] bg-pine-900 p-6 text-paper sm:flex-row sm:items-center sm:p-8" data-reveal>
      <div>
        <p class="text-[18px] font-medium">After launch: Care plans from $300/month.</p>
        <p class="mt-1 text-[15px] text-paper/60">Updates, new sections, landing pages, monitoring. Optional, cancel any time.</p>
      </div>
      <a href={url('/start/')} class="btn-primary">Start your website</a>
    </div>
  </div>
</section>
