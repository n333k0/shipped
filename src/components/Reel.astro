---
// Marquee of device shots, shared by the home hero and the budget funnel.
// /work = our projects, /placeholder = stand-ins to replace.
import { url } from '../lib/url';
import { srcset } from '../lib/img';

const { class: className = '' } = Astro.props;
const tiles = [
  { src: '/placeholder/laptop-typing.webp', w: 'w-[240px] sm:w-[300px]', h: 'h-[300px] sm:h-[380px]' },
  { src: '/placeholder/phone-hands.webp', w: 'w-[220px] sm:w-[280px]', h: 'h-[240px] sm:h-[300px]' },
  { src: '/work/studio-dado.webp', w: 'w-[260px] sm:w-[340px]', h: 'h-[300px] sm:h-[400px]' },
  { src: '/work/1red-wide.webp', w: 'w-[340px] sm:w-[460px]', h: 'h-[220px] sm:h-[280px]' },
  { src: '/placeholder/tablet-founder.webp', w: 'w-[220px] sm:w-[280px]', h: 'h-[260px] sm:h-[340px]' },
  { src: '/work/tokni.webp', w: 'w-[240px] sm:w-[320px]', h: 'h-[300px] sm:h-[380px]' },
  { src: '/work/perfect-body-wide.webp', w: 'w-[360px] sm:w-[450px]', h: 'h-[240px] sm:h-[300px]' },
  { src: '/placeholder/laptop-ladder.webp', w: 'w-[220px] sm:w-[280px]', h: 'h-[280px] sm:h-[360px]' },
];
const loop = [...tiles, ...tiles];
---

<div class:list={['reel relative', className]} aria-label="Recent work (placeholder imagery)">
  <div class="flex w-max items-end gap-4 animate-marquee hover:[animation-play-state:paused]">
    {loop.map((t, i) => (
      <div class:list={['shrink-0 overflow-hidden rounded-[22px] bg-pine-800', t.w, t.h]} aria-hidden={i >= tiles.length ? 'true' : undefined}>
        <img class="size-full object-cover" src={url(t.src)} srcset={srcset(t.src)} sizes="(min-width: 640px) 300px, 240px" alt="" loading={i < 5 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>
</div>

<style>
  /* edges fade the tiles themselves (no black bars), so whatever is behind the reel shows through */
  .reel { -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); }
</style>
