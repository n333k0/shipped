---
import { nextWeek } from '../data/site';
import { url } from '../lib/url';
---

<section class="wrap pb-24">
  <div class="relative overflow-hidden rounded-[36px] bg-spark px-6 py-20 text-center text-ink sm:py-28">
    <img class="absolute right-[-36px] top-[-30px] size-[110px] rotate-6 rounded-[20px] object-cover sm:size-[170px] md:right-[-60px] md:top-[-40px] md:size-[260px] md:rounded-[28px]" src={url('/work/tokni.webp')} alt="" loading="lazy" />
    <img class="absolute bottom-[-36px] left-[-30px] size-[100px] -rotate-6 rounded-[20px] object-cover sm:size-[150px] md:bottom-[-50px] md:left-[-40px] md:size-[220px] md:rounded-[28px]" src={url('/placeholder/laptop-typing.webp')} alt="" loading="lazy" />
    <div class="relative">
      <p class="label text-ink/60">Send brief. We build. You launch.</p>
      <h2 class="display mx-auto mt-6 max-w-[16ch] t-big"><span class="block">Come with a business.</span> <span class="accent block">Leave with a website.</span></h2>
      <div class="mx-auto mt-10 flex max-w-sm flex-col items-center justify-center gap-3 sm:max-w-none sm:flex-row">
        <a href={url('/start/')} class="btn-ink h-14 px-8 text-[16px] btn-wide">Start your website</a>
        <a href="#packages" class="btn-line-ink h-14 px-8 text-[16px] btn-wide">See packages</a>
      </div>
      {nextWeek && <p class="label mt-8 text-ink/60">Next available build: week of <span data-next-week>{nextWeek.label}</span></p>}
    </div>
  </div>
</section>
