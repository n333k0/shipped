---
// A concept website in a browser window or phone frame.
// Images come from public/mockups (rendered by scripts/render-mockups.sh).
import { url } from '../lib/url';

interface Props {
  site: string;
  device?: 'browser' | 'phone';
  domain?: string;
  class?: string;
  eager?: boolean;
}

const { site, device = 'browser', domain = `${site}.com`, class: cls = '', eager = false } = Astro.props;
const src = url(`/mockups/${site}${device === 'phone' ? '-m' : ''}.webp`);
const alt = `Concept website for ${site}`;
---

{device === 'browser' ? (
  <figure class:list={['overflow-hidden rounded-[14px] bg-[#1b1f1e] ring-1 ring-white/10', cls]}>
    <div class="flex h-7 items-center gap-1.5 px-3" aria-hidden="true">
      <span class="size-2 rounded-full bg-white/20"></span><span class="size-2 rounded-full bg-white/20"></span><span class="size-2 rounded-full bg-white/20"></span>
      <span class="mx-auto -translate-x-4 rounded-md bg-white/10 px-6 py-0.5 font-mono text-[9px] text-white/50">{domain}</span>
    </div>
    <img src={src} alt={alt} width="1200" height="750" loading={eager ? 'eager' : 'lazy'} class="block aspect-[16/10] w-full object-cover object-top" />
  </figure>
) : (
  <figure class:list={['relative overflow-hidden rounded-[30px] bg-[#111] p-[5px] ring-1 ring-white/10', cls]}>
    <span class="absolute left-1/2 top-[11px] z-10 h-[14px] w-[64px] -translate-x-1/2 rounded-full bg-black" aria-hidden="true"></span>
    <img src={src} alt={alt} width="780" height="1688" loading={eager ? 'eager' : 'lazy'} class="block aspect-[390/844] w-full rounded-[25px] object-cover object-top" />
  </figure>
)}
