---
// Hero background: Paper Shaders "Dithering" (Apache-2.0, @paper-design/shaders), warp shape,
// 4×4 Bayer, in shipped's lime on black. Speeds up while the pointer is over the hero.
// Pauses off-screen (built into ShaderMount), stays still for reduced motion.
const { class: className = '' } = Astro.props;
---

<div class:list={['shader pointer-events-none', className]} aria-hidden="true">
  <div class="mount absolute inset-0 opacity-40 mix-blend-screen"></div>
  <!-- a short fade into the next section (no shadow under the nav) -->
  <div class="absolute inset-x-0 bottom-0 h-[40%] bg-gradient-to-b from-transparent via-black/75 to-black"></div>
</div>

<style>
  /* like queued: the dither frames the copy instead of sitting behind it (centre masked out) */
  .shader .mount {
    -webkit-mask-image: radial-gradient(ellipse 54% 42% at 50% 32%, transparent 48%, #000 100%);
    mask-image: radial-gradient(ellipse 54% 42% at 50% 32%, transparent 48%, #000 100%);
  }
  /* phones: the copy spans the full width, so the dither only shows below it */
  @media (max-width: 767px) {
    .shader .mount {
      -webkit-mask-image: linear-gradient(to bottom, transparent 60%, #000 84%);
      mask-image: linear-gradient(to bottom, transparent 60%, #000 84%);
    }
  }
</style>

<script>
  import { ShaderMount, ditheringFragmentShader, DitheringShapes, DitheringTypes, getShaderColorFromString, ShaderFitOptions } from '@paper-design/shaders';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const box of document.querySelectorAll<HTMLElement>('.shader')) {
    const el = box.querySelector<HTMLElement>('.mount')!;
    let mount: ShaderMount;
    try {
      mount = new ShaderMount(el, ditheringFragmentShader, {
        u_colorBack: getShaderColorFromString('#00000000'),
        u_colorFront: getShaderColorFromString('#d8ff85'),
        u_shape: DitheringShapes.warp,
        u_type: DitheringTypes['4x4'],
        u_pxSize: 2, // whole numbers only: fractional sizes give an uneven grid
        u_fit: ShaderFitOptions.cover,
        u_scale: 1,
        u_rotation: 0,
        u_offsetX: 0,
        u_offsetY: 0,
        u_originX: 0.5,
        u_originY: 0.5,
        u_worldWidth: 0,
        u_worldHeight: 0,
      }, undefined, still ? 0 : 0.2, 0, 1, 1920 * 1080);
    } catch { continue; /* no WebGL: plain black hero */ }
    if (still) continue;
    // faster while the pointer is over the hero
    const hero = box.parentElement!;
    hero.addEventListener('pointerenter', () => mount.setSpeed(0.6));
    hero.addEventListener('pointerleave', () => mount.setSpeed(0.2));
  }
</script>
