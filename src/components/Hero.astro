---
import { nextWeek, openSlotsThisMonth, monthName, packages } from '../data/site';
import { url } from '../lib/url';
import ParentLogo from './ParentLogo.astro';
import { brand } from '../data/site';

// Device shots: /work = our projects, /placeholder = stand-ins to replace.
const tiles = [
  { src: '/placeholder/laptop-typing.webp', w: 'w-[240px] sm:w-[300px]', h: 'h-[300px] sm:h-[380px]' },
  { src: '/placeholder/phone-hands.webp', w: 'w-[220px] sm:w-[280px]', h: 'h-[240px] sm:h-[300px]' },
  { src: '/placeholder/tablet-method.webp', w: 'w-[260px] sm:w-[340px]', h: 'h-[300px] sm:h-[400px]' },
  { src: '/work/1red.webp', w: 'w-[340px] sm:w-[460px]', h: 'h-[220px] sm:h-[280px]' },
  { src: '/placeholder/tablet-founder.webp', w: 'w-[220px] sm:w-[280px]', h: 'h-[260px] sm:h-[340px]' },
  { src: '/work/tokni.webp', w: 'w-[240px] sm:w-[320px]', h: 'h-[300px] sm:h-[380px]' },
  { src: '/work/perfect-body-wide.webp', w: 'w-[360px] sm:w-[450px]', h: 'h-[240px] sm:h-[300px]' },
  { src: '/placeholder/laptop-ladder.webp', w: 'w-[220px] sm:w-[280px]', h: 'h-[280px] sm:h-[360px]' },
];
const loop = [...tiles, ...tiles];
const from = packages[0].priceLabel;
---

<section class="relative overflow-hidden pt-[88px] sm:pt-[116px]">

  <div class="wrap relative text-center">
    {nextWeek && (
      <a href="#calendar" class="chip mx-auto border-white/15 bg-white/5 text-paper/80 hover:border-spark/60">
        <span class="dot"></span>
        {openSlotsThisMonth} {monthName} build slot{openSlotsThisMonth === 1 ? '' : 's'} open · next start {nextWeek.label}
      </a>
    )}

    <h1 class="display mx-auto mt-8 max-w-[14ch] text-[clamp(48px,9vw,128px)]">
      Your new website. <span class="accent text-spark">Without the agency.</span>
    </h1>

    <p class="mx-auto mt-7 max-w-[600px] text-[18px] leading-relaxed text-paper/75 sm:text-[20px]">
      Strategy, copy, design and build for one fixed price. Choose it online, brief us in 20 minutes, launch in 5–20 business days.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href={url("/start/")} class="btn-primary h-14 px-8 text-[16px]">
        Start your website
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
      <a href="#packages" class="btn-ghost h-14 px-8 text-[16px]">See packages</a>
    </div>

    <ul class="label mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-paper/50">
      <li>No proposals</li>
      <li aria-hidden="true">/</li>
      <li>No hourly billing</li>
      <li aria-hidden="true">/</li>
      <li>No meetings required</li>
      <li aria-hidden="true">/</li>
      <li>From {from}</li>
    </ul>

    <a href={brand.parentUrl} class="mt-7 inline-flex items-center gap-2 text-white/90 transition hover:text-white" aria-label={`${brand.parentLine} ${brand.parent}`}>
      <span class="font-sans text-[14px] leading-none text-paper/55">{brand.parentLine}</span>
      <ParentLogo class="h-[14px]" />
    </a>
  </div>

  <div class="relative mt-16 sm:mt-20" aria-label="Recent work (placeholder imagery)">
    <div class="flex w-max items-end gap-4 animate-marquee hover:[animation-play-state:paused]">
      {loop.map((t, i) => (
        <div class:list={['shrink-0 overflow-hidden rounded-[22px] bg-pine-800', t.w, t.h]} aria-hidden={i >= tiles.length ? 'true' : undefined}>
          <img class="size-full object-cover" src={url(t.src)} alt="" loading={i < 5 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-pine-900 sm:w-40" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-pine-900 sm:w-40" aria-hidden="true"></div>
  </div>
</section>

<!-- Facts strip -->
<section class="border-y border-white/10 mt-16 sm:mt-24">
  <div class="wrap grid grid-cols-2 divide-white/10 md:grid-cols-4 md:divide-x">
    {[
      ['Fixed price', 'On the page. No quote.'],
      ['5–20 days', 'From brief to live.'],
      ['Async', 'No meetings required.'],
      ['Yours', 'You own every pixel.'],
    ].map(([k, v]) => (
      <div class="px-2 py-8 md:px-8">
        <p class="text-[22px] font-medium tracking-tight sm:text-[26px]">{k}</p>
        <p class="mt-1 text-[14px] text-paper/55">{v}</p>
      </div>
    ))}
  </div>
</section>
