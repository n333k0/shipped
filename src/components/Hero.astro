---
import { nextWeek, openSlotsThisMonth, monthName, packages } from '../data/site';
import { url } from '../lib/url';
import ParentLogo from './ParentLogo.astro';
import Reel from './Reel.astro';
import Shader from './Shader.astro';
import { brand } from '../data/site';

const from = packages[0].priceLabel;
---

<section class="relative overflow-hidden pb-10 sm:pb-14">
  <!-- the shader runs behind the copy and the reel -->
  <Shader class="absolute inset-0" />
  <div class="relative pb-12 pt-[88px] sm:pb-14 sm:pt-[116px]">

  <div class="wrap relative text-center">
    {nextWeek && (
      <a href="#calendar" class="chip mx-auto border-white/15 bg-white/5 text-paper/80 hover:border-spark/60">
        <span class="dot"></span>
        {openSlotsThisMonth} {monthName} build slot{openSlotsThisMonth === 1 ? '' : 's'} open
      </a>
    )}

    <h1 class="display mx-auto mt-6 max-w-[14ch] t-hero">
      Your new website. <span class="accent text-spark">Without the agency.</span>
    </h1>

    <p class="mx-auto mt-5 max-w-[680px] text-[16px] leading-relaxed text-paper/75 sm:text-[17px]">
      Strategy, copy, design and build for one fixed price. Choose it online, brief us in 20 minutes, launch in 5–20 business days.
    </p>

    <div class="mx-auto mt-7 flex max-w-sm flex-col items-center justify-center gap-3 sm:max-w-none sm:flex-row">
      <a href={url("/start/")} class="btn-primary h-14 px-8 text-[16px] btn-wide">
        Start your website
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
      <a href="#packages" class="btn-ghost h-14 px-8 text-[16px] btn-wide">See packages</a>
    </div>

    <ul class="label mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-paper/50">
      <li>No proposals</li>
      <li aria-hidden="true">/</li>
      <li>No hourly billing</li>
      <li aria-hidden="true">/</li>
      <li>No meetings required</li>
      <li aria-hidden="true">/</li>
      <li>From {from}</li>
    </ul>

    <a href={brand.parentUrl} class="mt-5 inline-flex items-center gap-2 text-white/90 transition hover:text-white" aria-label={`${brand.parentLine} ${brand.parent}`}>
      <span class="font-sans text-[14px] leading-none text-paper/55">{brand.parentLine}</span>
      <ParentLogo class="h-[14px]" />
    </a>
  </div>
  </div>

  <Reel />
</section>

<!-- Facts strip -->
<section class="border-y border-white/10 mt-16 sm:mt-24">
  <div class="wrap grid grid-cols-2 divide-white/10 md:grid-cols-4 md:divide-x">
    {[
      ['Fixed price', 'On the page. No quote.'],
      ['5–20 days', 'From brief to live.'],
      ['Async', 'No meetings required.'],
      ['Yours', 'You own every pixel.'],
    ].map(([k, v]) => (
      <div class="px-2 py-8 md:px-8">
        <p class="text-[22px] font-medium tracking-tight sm:text-[26px]">{k}</p>
        <p class="mt-1 text-[14px] text-paper/55">{v}</p>
      </div>
    ))}
  </div>
</section>
