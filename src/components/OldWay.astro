---
import { url } from '../lib/url';
import { agencySteps, ourSteps, comparison, family } from '../data/site';
const queued = family.find((f) => f.key === 'queued')!;
// Work that drifts through the queued. banner: real pieces plus a few marks/specimens drawn in code.
type Work = { img?: string; w?: number; h?: number; made?: string };
const img = (name: string, w: number, h = 320): Work => ({ img: name, w, h });
const works: Record<string, Work> = {
  sublim: img('sublim', 348, 360), calder: img('calder', 338, 360), wilson: img('wilson', 360, 360),
  shift: img('shift', 686, 360), illo: img('illo', 648, 360), magazine: img('magazine', 281, 360),
  onered: img('onered', 480, 360), tokni: img('tokni', 377, 360), halden: img('halden', 288, 360),
  bloom: img('bloom', 512), fieldwork: img('fieldwork', 512), halcyon: img('halcyon', 512), kinetic: img('kinetic', 512),
  ledgerly: img('ledgerly', 512), lume: img('lume', 512), mira: img('mira', 512), nord: img('nord', 512), solace: img('solace', 512),
  antler: img('antler', 320), aether: img('aether', 320), print: img('print', 320),
  mark: { made: 'mark' }, palette: { made: 'palette' }, type: { made: 'type' }, word: { made: 'word' },
  poster: { made: 'poster' }, badge: { made: 'badge' }, mono: { made: 'mono' },
};
// Every piece appears once, and each lane is long enough that its loop never shows the same piece twice.
const lanes = [
  ['sublim', 'bloom', 'mark', 'shift', 'antler', 'ledgerly', 'palette'],
  ['calder', 'halcyon', 'type', 'onered', 'aether', 'mira', 'poster'],
  ['wilson', 'solace', 'word', 'tokni', 'print', 'kinetic', 'badge'],
  ['magazine', 'nord', 'mono', 'illo', 'halden', 'lume', 'fieldwork'],
].map((l) => l.map((k) => works[k]));
const made: Record<string, string> = {
  mark: '<svg viewBox="0 0 100 100" width="46%"><circle cx="38" cy="50" r="26" fill="#0b0b0b"/><circle cx="62" cy="50" r="26" fill="none" stroke="#0b0b0b" stroke-width="6"/></svg><b>orbit</b>',
  palette: '<i style="background:#14213d"></i><i style="background:#fca311"></i><i style="background:#e5e5e5"></i><i style="background:#6a994e"></i>',
  type: '<em>Aa</em><b>Display serif · 400</b>',
  word: '<em>lumen</em>',
  poster: '<em>Open<br>studio<br>24</em><b>Fri · 7pm</b>',
  badge: '<span>est.<br>2026</span>',
  mono: '<em>K</em>',
};
---

<section id="why" class="pt-24 pb-14 sm:pt-32 sm:pb-16">
  <div class="wrap">
    <div class="max-w-4xl" data-reveal>
      <p class="label text-spark">Why this exists</p>
      <h2 class="display mt-4 t-h2">Great websites shouldn’t take <span class="accent text-spark">three months.</span></h2>
      <p class="mt-6 max-w-2xl text-[18px] text-paper/65">Agencies make good work. The process around it is the problem: most of a traditional website project is spent deciding how to start, then waiting between steps. So we kept the work and deleted the waiting.</p>
    </div>

    <!-- the two journeys -->
    <div class="mt-16 grid gap-5 lg:grid-cols-2">
      <div class="rounded-[28px] bg-white/[0.03] p-7 sm:p-9" data-reveal>
        <div class="flex items-center justify-between">
          <p class="label text-paper/50">The usual way</p>
          <p class="label text-booked">2–4 months</p>
        </div>
        <ol class="mt-7 flex flex-wrap gap-2">
          {agencySteps.map((s, i) => (
            <li class="flex items-center gap-2 text-[14px] text-paper/50">
              <span class="rounded-full border border-white/10 px-3 py-1.5 line-through decoration-white/25">{s}</span>
              {i < agencySteps.length - 1 && <span aria-hidden="true" class="text-paper/25">→</span>}
            </li>
          ))}
        </ol>
      </div>

      <div class="rounded-[28px] bg-spark p-7 text-ink sm:p-9" data-reveal>
        <div class="flex items-center justify-between">
          <p class="label text-ink/60">Our way</p>
          <p class="label">5–20 business days</p>
        </div>
        <ol class="mt-7 flex flex-wrap items-center gap-2">
          {ourSteps.map((s, i) => (
            <li class="flex items-center gap-2">
              <span class="rounded-full bg-ink px-5 py-2.5 text-[18px] font-normal text-paper sm:text-[22px]">{s}</span>
              {i < ourSteps.length - 1 && <span aria-hidden="true" class="text-[20px]">→</span>}
            </li>
          ))}
        </ol>
        <p class="mt-8 max-w-md text-[16px] text-ink/70">That’s the whole list. Nothing between the steps except the work.</p>
      </div>
    </div>

    <!-- comparison table: label | agency | shipped, a hairline between the two answers -->
    <div class="mt-5 overflow-hidden rounded-[22px] bg-white/[0.03] sm:rounded-[28px]" data-reveal>
      <div class="grid grid-cols-[0.8fr_1fr_1.1fr] text-[13px] leading-snug sm:grid-cols-[1.1fr_1fr_1fr] sm:text-[15px]">
        <div></div>
        <p class="label self-end pb-3 pl-[34px] pr-3 pt-5 text-paper/45 sm:pb-5 sm:pl-[58px] sm:pr-8 sm:pt-7"><span class="sm:hidden">Agency</span><span class="hidden sm:inline">Traditional agency</span></p>
        <p class="self-end border-l border-white/10 pb-2.5 pl-[34px] pr-3 pt-5 sm:pb-4 sm:pl-[58px] sm:pr-8 sm:pt-7">
          <span class="inline-flex items-baseline text-[19px] font-semibold tracking-[-0.04em] sm:text-[24px]">shipped<span class="logo-dot"></span></span>
        </p>
        {comparison.map(([k, them, us]) => (
          <>
            <p class="border-t border-white/[0.06] py-3.5 pl-4 pr-2 text-paper/45 sm:py-5 sm:pl-9 sm:pr-5 sm:text-paper/60">{k}</p>
            <p class="flex gap-2 border-t border-white/[0.06] px-3 py-3.5 text-paper/50 sm:gap-3 sm:px-8 sm:py-5 sm:text-paper/45">
              <svg class="mt-[3px] size-3.5 shrink-0 text-paper/30 sm:mt-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
              <span>{them}</span>
            </p>
            <p class="flex gap-2 border-l border-t border-l-white/10 border-t-white/[0.06] px-3 py-3.5 font-medium sm:gap-3 sm:px-8 sm:py-5">
              <svg class="mt-[3px] size-3.5 shrink-0 text-spark sm:mt-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>
              <span>{us}</span>
            </p>
          </>
        ))}
      </div>
    </div>

    <p class="mt-10 text-center text-[16px] text-paper/50">No shade to agencies. Some projects need six months and a steering committee. <span class="text-paper/80">Most websites don’t.</span></p>

    <!-- Section divider: cross-sell to queued., in queued's own orange. Copy on the left;
         on the right, tilted lanes of queued. work drift diagonally up and out of the frame. -->
    <a href={queued.url} class="q-promo group relative mt-14 flex flex-col overflow-hidden rounded-[28px] bg-[#ff6a3d] text-ink sm:mt-16 md:min-h-[380px] md:flex-row" data-reveal>
      <div class="q-works relative h-[220px] shrink-0 sm:h-[280px] md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[54%]" aria-hidden="true">
        <div class="q-stage">
          {lanes.map((lane, l) => (
            <div class="q-lane" style={`--d:${[56, 68, 50, 62][l]}s`}>
              {[0, 1, 2].map(() => lane.map((w) => (
                w.img
                  ? <img src={url(`/placeholder/queued/${w.img}.webp`)} alt="" width={w.w} height={w.h} decoding="async" class="q-card" style={`aspect-ratio:${w.w}/${w.h}`} />
                  : <span class:list={['q-card q-made', `q-${w.made}`]} set:html={made[w.made!]} />
              )))}
            </div>
          ))}
        </div>
      </div>
      <div class="relative z-[1] flex flex-col justify-between gap-8 px-6 pb-7 pt-6 sm:px-10 sm:pb-9 md:w-[50%] md:py-9 md:pl-12 md:pr-0">
        <span class="inline-flex items-baseline text-[20px] font-semibold tracking-[-0.04em] sm:text-[22px]" style="--color-spark: var(--color-ink)">queued<span class="logo-dot"></span></span>
        <span class="block">
          <span class="display block text-[42px] leading-[0.98] sm:text-[53px]">Need design every month<br /><span class="accent">after launch?</span></span>
          <span class="mt-4 block max-w-md text-[16px] leading-snug text-ink/70 sm:text-[17px]">Ads, decks, social posts, the next landing page. One flat monthly fee, about 48 hours a request.</span>
          <span class="btn mt-7 h-14 w-full bg-ink px-10 text-[16px] text-paper transition-colors group-hover:bg-black sm:w-auto sm:min-w-[260px]">See queued →</span>
        </span>
      </div>
    </a>
  </div>
</section>

<style>
  /* Lanes are tilted in perspective so they run bottom-left → top-right; each one loops forever.
     The left edge fades into the orange so work appears out of nowhere. */
  .q-works { perspective: 1100px; mask-image: linear-gradient(90deg, transparent, #000 28%); }
  @media (max-width: 767px) { .q-works { mask-image: linear-gradient(180deg, #000 70%, transparent); } }
  .q-stage {
    position: absolute; left: 50%; top: 50%; display: flex; flex-direction: column; gap: 6px;
    transform: translate(-50%, -50%) rotateX(18deg) rotate(-26deg);
  }
  .q-lane { display: flex; gap: 6px; width: max-content; animation: q-drift var(--d) linear infinite; will-change: transform; }
  .q-lane:nth-child(even) { margin-left: -70px; }
  /* three copies per lane; sliding by exactly one copy around the centre keeps both ends filled */
  @keyframes q-drift { from { transform: translateX(-16.6667%); } to { transform: translateX(16.6667%); } }
  .q-card { height: 112px; width: auto; flex: none; border-radius: 10px; object-fit: cover; }
  @media (min-width: 640px) { .q-card { height: 140px; } }
  .q-made { aspect-ratio: 1; font-size: clamp(14px, 1vw, 16px); display: grid; place-items: center; align-content: center; gap: 10px; overflow: hidden; color: #0b0b0b; }
  .q-made :global(b) { font: 600 0.8em/1 var(--font-sans); letter-spacing: -0.02em; }
  .q-mark { background: #f3f1ea; }
  .q-palette { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .q-palette :global(i) { height: 100%; }
  .q-type { background: #0b0b0b; color: #f3f1ea; }
  .q-type :global(em) { font: italic 400 3.4em/0.9 var(--font-serif); }
  .q-type :global(b) { font: 400 10px/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; opacity: .6; }
  .q-word { background: #c7d2fe; }
  .q-word :global(em) { font: 600 2.2em/1 var(--font-sans); font-style: normal; letter-spacing: -0.06em; }
  .q-poster { background: #d8ff85; justify-items: start; padding: 0 14%; }
  .q-poster :global(em) { font: 700 1.9em/0.86 var(--font-sans); font-style: normal; letter-spacing: -0.05em; text-transform: uppercase; }
  .q-poster :global(b) { font: 500 0.7em/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .q-badge { background: #0b3d2e; }
  .q-badge :global(span) { display: grid; place-items: center; width: 62%; aspect-ratio: 1; border-radius: 50%; background: #f3c4d1; color: #0b3d2e; font: italic 400 1.5em/0.95 var(--font-serif); text-align: center; }
  .q-mono { background: #fff4e0; }
  .q-mono :global(em) { font: italic 400 5.5em/1 var(--font-serif); color: #c2410c; }
  @media (prefers-reduced-motion: reduce) { .q-lane { animation: none; } }
</style>
