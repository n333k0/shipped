---
import { url } from '../lib/url';
import { agencySteps, ourSteps, comparison, family } from '../data/site';
const queued = family.find((f) => f.key === 'queued')!;
const fan = ['magazine', 'donuts', 'merch'];
---

<section id="why" class="pt-24 pb-14 sm:pt-32 sm:pb-16">
  <div class="wrap">
    <div class="max-w-4xl" data-reveal>
      <p class="label text-spark">Why this exists</p>
      <h2 class="display mt-4 t-h2">Great websites shouldn’t take <span class="accent text-spark">three months.</span></h2>
      <p class="mt-6 max-w-2xl text-[18px] text-paper/65">Agencies make good work. The process around it is the problem: most of a traditional website project is spent deciding how to start, then waiting between steps. So we kept the work and deleted the waiting.</p>
    </div>

    <!-- the two journeys -->
    <div class="mt-16 grid gap-5 lg:grid-cols-2">
      <div class="rounded-[28px] bg-white/[0.03] p-7 sm:p-9" data-reveal>
        <div class="flex items-center justify-between">
          <p class="label text-paper/50">The usual way</p>
          <p class="label text-booked">2–4 months</p>
        </div>
        <ol class="mt-7 flex flex-wrap gap-2">
          {agencySteps.map((s, i) => (
            <li class="flex items-center gap-2 text-[14px] text-paper/50">
              <span class="rounded-full border border-white/10 px-3 py-1.5 line-through decoration-white/25">{s}</span>
              {i < agencySteps.length - 1 && <span aria-hidden="true" class="text-paper/25">→</span>}
            </li>
          ))}
        </ol>
      </div>

      <div class="rounded-[28px] bg-spark p-7 text-ink sm:p-9" data-reveal>
        <div class="flex items-center justify-between">
          <p class="label text-ink/60">Our way</p>
          <p class="label">5–20 business days</p>
        </div>
        <ol class="mt-7 flex flex-wrap items-center gap-2">
          {ourSteps.map((s, i) => (
            <li class="flex items-center gap-2">
              <span class="rounded-full bg-ink px-5 py-2.5 text-[18px] font-normal text-paper sm:text-[22px]">{s}</span>
              {i < ourSteps.length - 1 && <span aria-hidden="true" class="text-[20px]">→</span>}
            </li>
          ))}
        </ol>
        <p class="mt-8 max-w-md text-[16px] text-ink/70">That’s the whole list. Nothing between the steps except the work.</p>
      </div>
    </div>

    <!-- comparison table: label | agency | shipped, a hairline between the two answers -->
    <div class="mt-5 overflow-hidden rounded-[22px] bg-white/[0.03] sm:rounded-[28px]" data-reveal>
      <div class="grid grid-cols-[0.8fr_1fr_1.1fr] text-[13px] leading-snug sm:grid-cols-[1.1fr_1fr_1fr] sm:text-[15px]">
        <div></div>
        <p class="label self-end pb-3 pl-[34px] pr-3 pt-5 text-paper/45 sm:pb-5 sm:pl-[58px] sm:pr-8 sm:pt-7"><span class="sm:hidden">Agency</span><span class="hidden sm:inline">Traditional agency</span></p>
        <p class="self-end border-l border-white/10 pb-2.5 pl-[34px] pr-3 pt-5 sm:pb-4 sm:pl-[58px] sm:pr-8 sm:pt-7">
          <span class="inline-flex items-baseline text-[19px] font-semibold tracking-[-0.04em] sm:text-[24px]">shipped<span class="logo-dot"></span></span>
        </p>
        {comparison.map(([k, them, us]) => (
          <>
            <p class="border-t border-white/[0.06] py-3.5 pl-4 pr-2 text-paper/45 sm:py-5 sm:pl-9 sm:pr-5 sm:text-paper/60">{k}</p>
            <p class="flex gap-2 border-t border-white/[0.06] px-3 py-3.5 text-paper/50 sm:gap-3 sm:px-8 sm:py-5 sm:text-paper/45">
              <svg class="mt-[3px] size-3.5 shrink-0 text-paper/30 sm:mt-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
              <span>{them}</span>
            </p>
            <p class="flex gap-2 border-l border-t border-l-white/10 border-t-white/[0.06] px-3 py-3.5 font-medium sm:gap-3 sm:px-8 sm:py-5">
              <svg class="mt-[3px] size-3.5 shrink-0 text-spark sm:mt-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>
              <span>{us}</span>
            </p>
          </>
        ))}
      </div>
    </div>

    <p class="mt-10 text-center text-[16px] text-paper/50">No shade to agencies. Some projects need six months and a steering committee. <span class="text-paper/80">Most websites don’t.</span></p>

    <!-- Section divider: cross-sell to queued., in queued's own orange; half copy, half a fan of queued. work -->
    <a href={queued.url} class="q-promo group mt-14 grid overflow-hidden rounded-[28px] bg-[#ff6a3d] text-ink sm:mt-16 md:grid-cols-[1.05fr_1fr]" data-reveal>
      <div class="order-2 flex flex-col justify-center px-6 pb-7 pt-2 sm:px-10 sm:pb-10 md:order-1 md:py-12 md:pl-12 md:pr-4">
        <span class="inline-flex items-baseline text-[26px] font-semibold tracking-[-0.04em] sm:text-[30px]" style="--color-spark: var(--color-ink)">queued<span class="logo-dot"></span></span>
        <span class="display mt-4 block text-[30px] leading-[1.02] sm:text-[40px]">Need design every month after launch?</span>
        <span class="mt-3 block max-w-md text-[16px] leading-snug text-ink/70 sm:text-[17px]">Ads, decks, social posts, the next landing page. One flat monthly fee, about 48 hours a request.</span>
        <span class="btn mt-7 h-14 w-full bg-ink px-8 text-[16px] text-paper transition-colors group-hover:bg-black sm:w-fit">See queued →</span>
      </div>
      <div class="q-fan relative order-1 h-[205px] sm:h-[300px] md:order-2 md:h-auto md:min-h-[360px]" aria-hidden="true">
        {fan.map((f, i) => (
          <img src={url(`/placeholder/queued/${f}.webp`)} alt="" width="560" height="560" loading="lazy" decoding="async" class:list={['q-card absolute top-1/2 aspect-square w-[40%] max-w-[250px] rounded-[16px] object-cover sm:rounded-[20px]', `q-card-${i}`]} />
        ))}
      </div>
    </a>
  </div>
</section>

<style>
  /* the three cards fan out from the centre and spread a little on hover */
  .q-card { left: 50%; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .q-card-0 { transform: translate(-112%, -50%) rotate(-9deg); }
  .q-card-1 { transform: translate(-50%, -54%) rotate(2deg); z-index: 1; }
  .q-card-2 { transform: translate(12%, -48%) rotate(10deg); }
  .q-promo:hover .q-card-0 { transform: translate(-122%, -50%) rotate(-12deg); }
  .q-promo:hover .q-card-1 { transform: translate(-50%, -58%) rotate(0deg); }
  .q-promo:hover .q-card-2 { transform: translate(22%, -48%) rotate(13deg); }
  @media (prefers-reduced-motion: reduce) { .q-card { transition: none; } }
</style>
